{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "functions": {
    "api/router.js": {
      "maxDuration": 60
    },
    "api/kpay-checkout.js": {
      "maxDuration": 20
    },
    "api/kpay-notify.js": {
      "maxDuration": 20
    },
    "api/webhook.js": {
      "maxDuration": 20
    }
  },
  "crons": [
    {
      "path": "/api/cleanup-pending",
      "schedule": "0 16 * * *"
    }
  ],
  "redirects": [
    { "source": "/sai-ying-pun.html", "destination": "/sai-ying-pun", "permanent": true },
    { "source": "/tin-hau.html", "destination": "/tin-hau", "permanent": true },
    { "source": "/tsuen-wan.html", "destination": "/tsuen-wan", "permanent": true },
    { "source": "/fortress-hill", "destination": "/tin-hau", "permanent": true },
    { "source": "/fortress-hill.html", "destination": "/tin-hau", "permanent": true },
    { "source": "/menu.html", "destination": "/menu", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/admin-login", "destination": "/api/router?route=admin-login" },
    { "source": "/api/admin-menu", "destination": "/api/router?route=admin-menu" },
    { "source": "/api/kitchen-login", "destination": "/api/router?route=kitchen-login" },
    { "source": "/api/kitchen-menu", "destination": "/api/router?route=kitchen-menu" },
    { "source": "/api/checkout", "destination": "/api/router?route=checkout" },
    { "source": "/api/ai-parse-order", "destination": "/api/router?route=ai-parse-order" },
    { "source": "/api/upload-expense", "destination": "/api/router?route=upload-expense" },
    { "source": "/api/push-subscribe", "destination": "/api/router?route=push-subscribe" },
    { "source": "/api/push-vapid-public", "destination": "/api/router?route=push-vapid-public" },
    { "source": "/api/cleanup-pending", "destination": "/api/router?route=cleanup-pending" },

    { "source": "/sai-ying-pun", "destination": "/menu.html?store=SYP" },
    { "source": "/tin-hau", "destination": "/menu.html?store=TH" },
    { "source": "/tsuen-wan", "destination": "/menu.html?store=TW" },
    { "source": "/menu", "destination": "/menu.html?store=SYP" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/pos", "destination": "/pos.html" },
    { "source": "/kitchen", "destination": "/kitchen.html" },
    { "source": "/expense", "destination": "/expense.html" },
    { "source": "/acc-scan", "destination": "/acc-scan.html" },
    { "source": "/t/:store/:n", "destination": "/table.html" },
    { "source": "/t/:n", "destination": "/table.html" },
    { "source": "/p/:store", "destination": "/index.html" },
    { "source": "/tables", "destination": "/table-qr.html" }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    },
    {
      "source": "/pos",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, must-revalidate" },
        { "key": "Permissions-Policy", "value": "usb=*, serial=*" }
      ]
    },
    {
      "source": "/pos.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, must-revalidate" },
        { "key": "Permissions-Policy", "value": "usb=*, serial=*" }
      ]
    },
    {
      "source": "/kitchen",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    },
    {
      "source": "/kitchen.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    },
    {
      "source": "/expense",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Permissions-Policy", "value": "camera=*, microphone=()" }
      ]
    },
    {
      "source": "/expense.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Permissions-Policy", "value": "camera=*, microphone=()" }
      ]
    },
    {
      "source": "/acc-scan",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Permissions-Policy", "value": "camera=*, microphone=()" }
      ]
    },
    {
      "source": "/acc-scan.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Permissions-Policy", "value": "camera=*, microphone=()" }
      ]
    },
    {
      "source": "/t/:store/:n",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/t/:n",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/p/:store",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/tables",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/table-qr.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/table.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
